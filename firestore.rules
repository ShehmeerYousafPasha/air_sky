rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function canMovePaymentToProcessing(userId) {
      return isOwner(userId)
        && resource.data.userId == userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.flight == resource.data.flight
        && request.resource.data.passengers == resource.data.passengers
        && request.resource.data.seatNumbers == resource.data.seatNumbers
        && request.resource.data.passenger == resource.data.passenger
        && request.resource.data.seatNumber == resource.data.seatNumber
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == resource.data.status
        && request.resource.data.psid == resource.data.psid
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.paymentDueAt == resource.data.paymentDueAt
        && request.resource.data.updatedAt is int
        && request.resource.data.paymentStatus == 'payment_processing'
        && request.resource.data.paymentMethod == 'dummy_local'
        && request.resource.data.paidAt == null
        && request.resource.data.providerTransactionId.matches('^DUMMY-[0-9]{13}-[A-Z0-9]{6}$')
        && resource.data.paymentStatus == 'unpaid';
    }

    function canMovePaymentToPaid(userId) {
      return isOwner(userId)
        && resource.data.userId == userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.flight == resource.data.flight
        && request.resource.data.passengers == resource.data.passengers
        && request.resource.data.seatNumbers == resource.data.seatNumbers
        && request.resource.data.passenger == resource.data.passenger
        && request.resource.data.seatNumber == resource.data.seatNumber
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == resource.data.status
        && request.resource.data.psid == resource.data.psid
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.paymentDueAt == resource.data.paymentDueAt
        && request.resource.data.updatedAt is int
        && request.resource.data.paymentStatus == 'paid'
        && request.resource.data.paymentMethod == 'dummy_local'
        && request.resource.data.paidAt is int
        && request.resource.data.providerTransactionId.matches('^TXN-[A-Z0-9]{8,20}$')
        && resource.data.providerTransactionId.matches('^DUMMY-[0-9]{13}-[A-Z0-9]{6}$')
        && resource.data.paymentStatus == 'payment_processing'
        && resource.data.paymentMethod == 'dummy_local';
    }

    function canCancelBooking(userId) {
      return isOwner(userId)
        && resource.data.userId == userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.flight == resource.data.flight
        && request.resource.data.passengers == resource.data.passengers
        && request.resource.data.seatNumbers == resource.data.seatNumbers
        && request.resource.data.passenger == resource.data.passenger
        && request.resource.data.seatNumber == resource.data.seatNumber
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.psid == resource.data.psid
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.paymentDueAt == resource.data.paymentDueAt
        && request.resource.data.paidAt == resource.data.paidAt
        && request.resource.data.providerTransactionId == resource.data.providerTransactionId
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && request.resource.data.updatedAt is int
        && request.resource.data.cancelledAt is int
        && request.resource.data.status == 'cancelled'
        && resource.data.status == 'upcoming';
    }

    function canEditBooking(userId) {
      return isOwner(userId)
        && resource.data.userId == userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.flight == resource.data.flight
        && request.resource.data.passengers is list
        && request.resource.data.passengers.size() > 0
        && request.resource.data.passengers.size() == resource.data.passengers.size()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == resource.data.status
        && request.resource.data.psid == resource.data.psid
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.paymentDueAt == resource.data.paymentDueAt
        && request.resource.data.paidAt == resource.data.paidAt
        && request.resource.data.providerTransactionId == resource.data.providerTransactionId
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && request.resource.data.cancelledAt == resource.data.cancelledAt
        && request.resource.data.updatedAt is int
        && request.resource.data.seatNumbers is list
        && request.resource.data.seatNumbers.size() == request.resource.data.passengers.size()
        && request.resource.data.seatNumbers.size() == resource.data.seatNumbers.size()
        && request.resource.data.seatNumber == request.resource.data.seatNumbers[0]
        && request.resource.data.passenger == request.resource.data.passengers[0]
        && resource.data.paymentStatus == 'unpaid'
        && resource.data.status == 'upcoming';
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /bookings/{bookingId} {
        allow read: if isOwner(userId);

        // Client can only create an unpaid booking.
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.paymentStatus == 'unpaid'
          && request.resource.data.paymentMethod == 'psid'
          && request.resource.data.paidAt == null;

        // Spark-compatible dummy fallback: allow only strict unpaid ->
        // payment_processing -> paid transitions.
        allow update: if canMovePaymentToProcessing(userId)
          || canMovePaymentToPaid(userId)
          || canCancelBooking(userId)
          || canEditBooking(userId);
        allow delete: if false;
      }
    }

    match /public_notifications/{notificationId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
